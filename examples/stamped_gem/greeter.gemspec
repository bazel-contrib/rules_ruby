# frozen_string_literal: true

root = File.expand_path(__dir__)
# lib/greeter/version.rb is a build output, so outside Bazel load it from bazel-bin.
bazel_lib = File.join(root, 'bazel-bin/lib')
$LOAD_PATH.unshift(bazel_lib) if File.directory?(bazel_lib)
$LOAD_PATH.push(File.join(root, 'lib'))
require 'greeter/version'

Gem::Specification.new do |s|
  s.name = 'greeter'
  s.version = Greeter::VERSION
  s.authors = ['Foo Bar']
  s.summary = 'Example of a gem whose version is generated by Bazel'
  s.license = 'MIT'
  s.files = Dir['lib/**/*.rb']
  s.require_paths = ['lib']
  s.required_ruby_version = '>= 3.0'
  s.metadata['rubygems_mfa_required'] = 'true'
end
